<?xml version="1.0" encoding="utf-8"?>
<!-- TLS only, system CAs only. The app holds no INTERNET permission and makes no requests of its
     own (built-in AI is retired); this stays as defence in depth. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
