<?xml version="1.0" encoding="utf-8"?>
<!-- TLS only, system CAs only (user-installed CAs can't intercept AI requests).
     The only network use is optional, user-triggered AI planning (api.anthropic.com). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
