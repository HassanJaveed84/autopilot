<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Runtime permission on Android 13+; requested contextually when the first reminder is set. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Rebuild alarms after reboot (alarms do not survive a restart). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Special access, OFF unless the user opts into precision mode and grants it in Settings.
         USE_EXACT_ALARM is intentionally NOT declared (restricted to alarm/calendar apps). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- WorkManager declares FOREGROUND_SERVICE for foreground workers; this app never runs a
         foreground service (SPEC §5.4), so the merged permission is removed. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />
    <!-- Network is used ONLY for optional, user-triggered AI planning requests to
         api.anthropic.com (M2, off by default). Tasks and reminders never need it. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets AI planning say "you're offline" before attempting a request. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".LifeAdminApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifeAdmin"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Alarm deliveries: only our own AlarmManager PendingIntents target this receiver. -->
        <receiver
            android:name=".receivers.ReminderAlarmReceiver"
            android:exported="false">
            <!-- Filter documents the contract; exported=false keeps it unreachable from other apps. -->
            <intent-filter>
                <action android:name="com.lifeadmin.autopilot.action.REMINDER_FIRE" />
                <action android:name="com.lifeadmin.autopilot.action.TEST_REMINDER_FIRE" />
                <data android:scheme="lifeadmin" />
            </intent-filter>
        </receiver>

        <!-- Notification Done/Snooze buttons (explicit, immutable PendingIntents). -->
        <receiver
            android:name=".receivers.NotificationActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.lifeadmin.autopilot.action.DONE" />
                <action android:name="com.lifeadmin.autopilot.action.SNOOZE" />
                <action android:name="com.lifeadmin.autopilot.action.DONE_FOR_NOW" />
                <data android:scheme="lifeadmin" android:host="task" />
            </intent-filter>
        </receiver>

        <!-- Protected system broadcasts that clear or invalidate alarms. Handler is an idempotent reconcile. -->
        <receiver
            android:name=".receivers.SystemEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
